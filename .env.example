APP_NAME=BXCode
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bxcode
DB_USERNAME=root
DB_PASSWORD=
# DB_LOG_QUERIES defaults to APP_DEBUG when unset.

LOG_LEVEL=debug

CACHE_PREFIX=
# CACHE_PATH and STORAGE_ROOT default to storage/cache and storage/app.

RATELIMIT_MAX=60
RATELIMIT_DECAY=60
